{
  "name": "asset-scheduler",
  "version": "2.0.0",
  "description": "Embeddable React component for visually tracking and scheduling assets — live map, resource allocator, and schedule/asset/location views in one ops console.",
  "license": "MIT",
  "type": "module",
  "module": "./dist/works-calendar.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/works-calendar.es.js"
    },
    "./xlsx": {
      "types": "./dist/xlsx.d.ts",
      "import": "./dist/xlsx.js"
    },
    "./styles": {
      "import": "./dist/style.css",
      "default": "./dist/style.css"
    },
    "./styles/family": {
      "import": "./dist/themes/family/index.css",
      "default": "./dist/themes/family/index.css"
    },
    "./styles/family/ops": {
      "import": "./dist/themes/family/ops.css",
      "default": "./dist/themes/family/ops.css"
    },
    "./themes": {
      "types": "./dist/index.d.ts",
      "import": "./dist/works-calendar.es.js"
    },
    "./dist/*": "./dist/*"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.module.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WorksCalendar/AssetScheduler.git"
  },
  "homepage": "https://github.com/WorksCalendar/AssetScheduler#readme",
  "bugs": {
    "url": "https://github.com/WorksCalendar/AssetScheduler/issues"
  },
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "build:demo": "vite build --config vite.demo.config.ts",
    "test": "cross-env TZ=UTC vitest run",
    "test:watch": "cross-env TZ=UTC vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "build": "vite build",
    "type-check": "tsc --noEmit --project tsconfig.build.json",
    "type-check:watch": "tsc --noEmit --project tsconfig.build.json --watch",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "package:check": "attw --pack . --profile esm-only --entrypoints . ./xlsx ./themes",
    "check": "npm run type-check && npm run lint && npm run test",
    "prepublishOnly": "npm run build && npm run package:check"
  },
  "peerDependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "date-fns": "^3.6.0",
    "exceljs": "^4.4.0",
    "lucide-react": ">=0.378.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@supabase/supabase-js": {
      "optional": true
    },
    "exceljs": {
      "optional": true
    }
  },
  "dependencies": {
    "@radix-ui/react-slider": "^1.3.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fuse.js": "^7.3.0",
    "tailwind-merge": "^3.6.0",
    "works-calendar-engine": "^0.1.2"
  },
  "overrides": {
    "exceljs": {
      "archiver": "^7.0.1",
      "fast-csv": "^5.0.2",
      "unzipper": "^0.12.3",
      "uuid": "^11.0.5"
    },
    "archiver-utils": {
      "glob": "^11.0.0"
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@playwright/test": "^1.60.0",
    "@supabase/supabase-js": "^2.0.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.19.39",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.5",
    "autoprefixer": "^10.5.0",
    "cross-env": "^10.1.0",
    "date-fns": "^3.6.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "exceljs": "^4.4.0",
    "happy-dom": "^20.8.9",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "lucide-react": "^0.378.0",
    "postcss": "^8.5.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.4"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --max-warnings=0 --no-warn-ignored"
    ]
  },
  "keywords": [
    "asset-tracking",
    "asset-scheduling",
    "dispatch",
    "fleet",
    "resource-allocation",
    "react",
    "map",
    "gantt",
    "scheduler"
  ]
}
